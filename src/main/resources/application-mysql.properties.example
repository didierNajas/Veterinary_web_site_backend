# Copia este archivo como application-mysql.properties y completa tus datos locales.
# application-mysql.properties NO se sube al repositorio (.gitignore).

spring.datasource.url=jdbc:mysql://localhost:3306/veterinaria?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.datasource.username=root
spring.datasource.password=TU_PASSWORD_AQUI

spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=true
spring.jpa.open-in-view=false

spring.h2.console.enabled=false
